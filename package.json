{
  "name": "llmpk",
  "version": "0.6.2",
  "description": "LLM leaderboards and AI news in your terminal",
  "type": "module",
  "license": "MIT",
  "bin": {
    "llmpk": "src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "dev": "bun --watch src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test tests/ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "build": "bun run scripts/build.ts",
    "smoke": "bun run scripts/smoke.ts",
    "package": "bun run scripts/package.ts",
    "package:verify": "bun run scripts/package.ts --verify"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
